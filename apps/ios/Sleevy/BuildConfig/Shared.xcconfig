DEVELOPMENT_TEAM =
GOOGLE_CLIENT_ID_IOS = REPLACE_WITH_IOS_CLIENT_ID
GOOGLE_REVERSED_CLIENT_ID_IOS = REPLACE_WITH_IOS_REVERSED_CLIENT_ID
GOOGLE_SERVER_CLIENT_ID = REPLACE_WITH_WEB_CLIENT_ID
SLEEVY_API_BASE_URL = https:/$()/api.sleevy.app

// Debug builds are the Dev Variant: a separate app ("Sleevy Dev") with its own
// bundle ids, app group, keychain group and URL scheme, so it installs next to
// the App Store app instead of replacing it. Release builds are unchanged.
SLEEVY_VARIANT_SUFFIX =
SLEEVY_VARIANT_SUFFIX[config=Debug] = .dev
SLEEVY_DISPLAY_NAME = Sleevy
SLEEVY_DISPLAY_NAME[config=Debug] = Sleevy Dev
SLEEVY_URL_SCHEME = sleevy
SLEEVY_URL_SCHEME[config=Debug] = sleevy-dev
SLEEVY_APP_ICON = AppIcon
SLEEVY_APP_ICON[config=Debug] = AppIconDev
SLEEVY_APP_BUNDLE_ID = app.sleevy$(SLEEVY_VARIANT_SUFFIX)
SLEEVY_APP_GROUP = group.app.sleevy$(SLEEVY_VARIANT_SUFFIX)
SLEEVY_KEYCHAIN_GROUP = $(AppIdentifierPrefix)app.sleevy$(SLEEVY_VARIANT_SUFFIX)

// Local overrides live in BuildConfig/Local.xcconfig, which is gitignored.
// Use that file for real team ids, client ids, and environment-specific API hosts.
#include? "Local.xcconfig"
